@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# dependencies that are not part of the memilio export. Bundled spdlog and jsoncpp are installed next to memilio.
# Bundled header-only libraries (Eigen, Boost, Random123) are exported with memilio and need no lookup.
find_dependency(spdlog CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
if(NOT @MEMILIO_USE_BUNDLED_EIGEN@)
    find_dependency(Eigen3 @MEMILIO_EIGEN_VERSION@ NO_MODULE)
endif()
if(NOT @MEMILIO_USE_BUNDLED_BOOST@)
    find_dependency(Boost @MEMILIO_MINIMAL_BOOST_VERSION@...@MEMILIO_BOOST_VERSION@ COMPONENTS outcome optional)
endif()
if(@MEMILIO_HAS_JSONCPP@)
    find_dependency(jsoncpp CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
endif()
if(@MEMILIO_HAS_HDF5@)
    find_dependency(HDF5 COMPONENTS C)
endif()
if(@MEMILIO_ENABLE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif()
if(@MEMILIO_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
if(@MEMILIO_ENABLE_LIKWID_MARKER@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Likwid)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/memilio-targets.cmake")

set(MEMILIO_HAS_JSONCPP @MEMILIO_HAS_JSONCPP@)
set(MEMILIO_HAS_HDF5 @MEMILIO_HAS_HDF5@)
set(MEMILIO_LIBRARIES memilio::memilio)

check_required_components(memilio)
